# Copy this file to .env.local and fill in real values.
# Get Supabase values from your project's Settings > API page (https://supabase.com — free tier).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary (free tier) — used for avatar/cover/post media upload.
# Create an unsigned upload preset in Cloudinary Console > Settings > Upload for the two NEXT_PUBLIC_ vars below.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Server-only Cloudinary credentials, for signed operations (deletion, moderation) in a later phase.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# PostHog (free tier) — product analytics. Leave blank to disable tracking entirely.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Ollama (free, self-hosted) — powers AI caption/bio/tag suggestions.
# Install from https://ollama.com, then run: ollama pull qwen3:4b
# Leave as default for local dev; the AI features no-op with a clear message if Ollama isn't running.
NEXT_PUBLIC_OLLAMA_URL=http://localhost:11434
